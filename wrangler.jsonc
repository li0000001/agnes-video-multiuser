{
  "name": "agnes-video-multiuser",
  "compatibility_date": "2025-10-15",
  "pages_build_output_dir": "./public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agnes_video_db",
      "database_id": "7e1b4628-55eb-4b80-8e01-5547ae6cf814"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "agnes-video-r2"
    }
  ],
  "vars": {
    "SESSION_NAME": "agnes_session",
    "POLL_BATCH": "15",
    "ZOMBIE_MINUTES": "40",
    "PRESIGN_EXPIRES": "900"
  }
}